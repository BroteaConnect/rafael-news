---
import type { AuthorView } from '../lib/content/types';
import { localePath, t } from '../lib/i18n';

interface Props { locale: string; author: AuthorView; stories: number }
const { locale, author, stories } = Astro.props;
---

<section id="autor" class="section container" aria-labelledby="author-title">
  <h2 class="section-title" id="author-title">{t(locale, 'author.section')}</h2>
  <div class="who">
    {/* Avatar tipográfico mientras no haya retrato real: una foto de archivo
        de un señor con corbata sería mentir sobre quién firma. */}
    <p class="portrait" aria-label={t(locale, 'a11y.author-photo', { name: author.name })}>
      <span aria-hidden="true">{author.initials}</span>
    </p>
    <div>
      <h3>{author.name}</h3>
      <p class="role">{author.role}</p>
      <p class="bio measure">{author.bio}</p>
      <p class="count">{t(locale, 'topics.count', { count: stories })}</p>
      <a href={localePath(locale, `/autor/${author.slug}`)}>{t(locale, 'author.all')}</a>
    </div>
  </div>
</section>

<style>
  .who { display: flex; gap: var(--space-4); align-items: flex-start; }
  .portrait {
    display: grid;
    place-items: center;
    flex: none;
    width: 96px;
    height: 96px;
    margin: 0;
    border-radius: var(--radius-lg);
    background: var(--primary);
    color: var(--primary-contrast);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
  }
  h3 { font-size: 1.375rem; }
  .role { margin: var(--space-1) 0 var(--space-3); color: var(--primary); font-weight: 600; font-size: 0.9375rem; }
  .bio { margin: 0; color: var(--muted); }
  .count { margin: var(--space-3) 0 0; color: var(--muted); font-size: 0.8125rem; }
</style>
