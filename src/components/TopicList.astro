---
import type { TopicView } from '../lib/content/types';
import { localePath, t } from '../lib/i18n';

interface Props { locale: string; topics: TopicView[] }
const { locale, topics } = Astro.props;

// Los temas se distinguen por NOMBRE e icono, no por cuatro colores inventados:
// inventarlos rompería la paleta del tema y dejaría el dato fuera del alcance de
// quien no distingue tonos. Si algún día la marca quiere una gama categórica,
// entra en el contrato de tema como gama, no como cuatro parches aquí.
const ICON: Record<string, string> = { macro: '◴', markets: '▤', crypto: '◈', fx: '⇄' };
---

<section id="temas" class="section container" aria-labelledby="topics-title">
  <h2 class="section-title" id="topics-title">{t(locale, 'topics.section')}</h2>
  <ul class="tiles">
    {topics.map((topic) => (
      <li>
        <a href={localePath(locale, `/tema/${topic.slug}`)}>
          <span class="icon" aria-hidden="true">{ICON[topic.id]}</span>
          <span class="name">{topic.name}</span>
          <span class="count">{t(locale, 'topics.count', { count: topic.count })}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(2, 1fr); }
  li { height: 100%; }
  a {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }
  a:hover { border-color: var(--primary); color: var(--primary); }
  .icon { font-size: 1.5rem; color: var(--primary); line-height: 1; }
  .name { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; }
  .count { color: var(--muted); font-size: 0.8125rem; }
  @media (min-width: 700px) { .tiles { grid-template-columns: repeat(4, 1fr); } }
</style>
