---
import { getMarket, isStale, localize } from '../lib/content/store';
import { ARROW, directionOf, formatPct, formatQuote, formatTime } from '../lib/format';
import { t } from '../lib/i18n';

interface Props { locale: string }
const { locale } = Astro.props;

// Se renderiza en el servidor con la última instantánea: la barra ocupa su
// sitio desde el primer pintado, así que no aporta ni un pixel de CLS. F3 le
// añadirá el sondeo al proveedor dentro de estas mismas celdas.
const market = await getMarket();
const stale = isStale(market);
---

<div class="market" data-as-of={market.asOf}>
  <div class="container inner">
    <ul aria-label={t(locale, 'a11y.market')}>
      {market.quotes.map((quote) => {
        const dir = directionOf(quote.changePct);
        const pct = formatPct(locale, quote.changePct);
        return (
          <li>
            <span class="name">{localize(quote.name, locale)}</span>
            <span class="value">{formatQuote(locale, quote.value, quote.decimals)}</span>
            {/* La dirección va en flecha, signo y etiqueta accesible, nunca solo
                en el color: si el color fuera la única pista, el dato no
                existiría para quien no lo distingue. */}
            <span class={`chg ${dir}`} aria-hidden="true">{ARROW[dir]} {pct}</span>
            <span class="visually-hidden">{t(locale, `a11y.market.${dir}`, { value: pct })}</span>
          </li>
        );
      })}
    </ul>
    {/* Qué son estos números se dice SIEMPRE, y en este orden: de muestra
        mientras no hay proveedor (F3), caducados si el sondeo se cayó, y si no,
        el retardo declarado —que es una condición contractual de los
        proveedores de datos, no un adorno que se pueda esconder por espacio. */}
    <p class="note">
      {market.sample
        ? t(locale, 'market.sample')
        : stale
          ? t(locale, 'market.stale')
          : t(locale, 'market.delay', { minutes: market.delayMinutes, time: formatTime(locale, market.asOf) })}
    </p>
  </div>
</div>

<style>
  .market {
    background: var(--bg);
    border-block-start: 1px solid var(--border);
    font-size: 0.8125rem;
  }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); min-height: 36px; padding-block: var(--space-1); }
  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    /* En móvil rueda; cada indicador encaja entero, no a medias. */
    scroll-snap-type: x proximity;
  }
  ul::-webkit-scrollbar { display: none; }
  li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    white-space: nowrap;
    scroll-snap-align: start;
  }
  .name { color: var(--muted); font-weight: 600; }
  /* Cifras de ancho fijo: al refrescar, un 1 no puede encoger la celda y
   * empujar la barra entera. */
  .value, .chg { font-variant-numeric: tabular-nums; }
  /* --ok/--danger pasan AA como adorno, no como texto: para texto están sus
   * variantes -strong, que es exactamente para lo que existen. */
  .chg.up { color: var(--ok-strong); }
  .chg.down { color: var(--danger-strong); }
  .chg.flat { color: var(--muted); }
  /* El aviso de retardo se ve SIEMPRE, también en móvil: es una condición de
   * los proveedores de datos, no un adorno que se pueda esconder por espacio. */
  .note { margin: 0; color: var(--muted); font-size: 0.75rem; }
  @media (min-width: 1100px) { .note { margin-inline-start: auto; white-space: nowrap; } }
</style>
