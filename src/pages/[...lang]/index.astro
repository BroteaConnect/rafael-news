---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterStrip from '../../components/NewsletterStrip.astro';
import AuthorBlock from '../../components/AuthorBlock.astro';
import TopicList from '../../components/TopicList.astro';
import { getArticles, getAuthor, getLeadStory, getTopics } from '../../lib/content/seed';
import { resolveLocale } from '../../lib/route';
import { t } from '../../lib/i18n';

// En salida de servidor no hay `getStaticPaths`: el idioma sale de la URL, y
// con él la obligación de rechazar lo que no es un idioma.
const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

const lead = await getLeadStory(locale);
const stories = (await getArticles(locale)).filter((story) => story.id !== lead.id);
const topics = await getTopics(locale);
const author = await getAuthor(locale);
const published = stories.length + 1;
---

<Layout locale={locale} title={t(locale, 'site.name')} description={t(locale, 'site.promise')}>
  <Hero locale={locale} story={lead} />

  <section id="hoy" class="section container" aria-labelledby="today-title">
    <h2 class="section-title" id="today-title">{t(locale, 'home.today')}</h2>
    <ul class="cards">
      {stories.map((story) => (
        <li><ArticleCard locale={locale} story={story} /></li>
      ))}
    </ul>
  </section>

  <NewsletterStrip locale={locale} />
  <AuthorBlock locale={locale} author={author} stories={published} />
  <TopicList locale={locale} topics={topics} />
</Layout>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    /* Una columna, dos o cuatro según el ancho disponible: lo decide la
     * rejilla, no una escalera de puntos de ruptura por dispositivo. */
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
</style>
