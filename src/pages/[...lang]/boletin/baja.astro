---
import Layout from '../../../layouts/Layout.astro';
import { unsubscribe } from '../../../lib/newsletter/store';
import { localePath, t } from '../../../lib/i18n';
import { resolveLocale } from '../../../lib/route';

// La baja se resuelve en UN clic desde el correo, sin pedir contraseña ni
// confirmar dos veces: poner fricción a una baja es lo que convierte un boletín
// en spam a ojos de quien lo recibe (y del filtro de su proveedor).
export const prerender = false;

const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

const token = Astro.url.searchParams.get('t') ?? '';
const result = token ? await unsubscribe(token) : 'unknown';
const ok = result === 'ok';
---

<Layout
  locale={locale}
  title={t(locale, ok ? 'boletin.baja.title' : 'boletin.invalido.title')}
  description={t(locale, ok ? 'boletin.baja.body' : 'boletin.invalido.body')}
>
  <section class="container aviso measure">
    <h1>{t(locale, ok ? 'boletin.baja.title' : 'boletin.invalido.title')}</h1>
    <p>{t(locale, ok ? 'boletin.baja.body' : 'boletin.invalido.body')}</p>
    <a class="btn" href={localePath(locale, '/')}>{t(locale, 'boletin.volver')}</a>
  </section>
</Layout>

<style>
  .aviso { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); padding-block: var(--space-6); }
  h1 { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem); }
  p { margin: 0; color: var(--muted); }
</style>
