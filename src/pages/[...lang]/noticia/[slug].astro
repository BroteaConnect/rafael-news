---
import Layout from '../../../layouts/Layout.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import { getStoriesByTopic, getStory } from '../../../lib/content/store';
import { formatDate } from '../../../lib/format';
import { localePath, t } from '../../../lib/i18n';
import { resolveLocale } from '../../../lib/route';

const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

const story = await getStory(String(Astro.params.slug ?? ''), locale);
if (!story) return Astro.rewrite('/404');

const related = (await getStoriesByTopic(story.topicId, locale))
  .filter((s) => s.id !== story.id)
  .slice(0, 3);

// Schema.org es lo que hace que un buscador entienda que esto es una noticia,
// con su autor y su fecha, en vez de una página cualquiera del sitio.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: story.title,
  description: story.standfirst,
  datePublished: story.publishedAt,
  author: { '@type': 'Person', name: story.author.name },
  publisher: { '@type': 'Organization', name: t(locale, 'site.name') },
};
---

<Layout locale={locale} title={story.title} description={story.standfirst}>
  <article class="container">
    <nav class="crumbs" aria-label={t(locale, 'a11y.breadcrumb')}>
      <a href={localePath(locale, '/')}>{t(locale, 'nav.home')}</a>
      <span aria-hidden="true">/</span>
      <a href={localePath(locale, `/tema/${story.topicSlug}`)}>{story.topicName}</a>
    </nav>

    <header class="head measure">
      <p class="meta">
        <span class="tag">{story.topicName}</span>
        <span class="relevance">· {t(locale, `relevance.${story.relevance}`)}</span>
      </p>
      <h1>{story.title}</h1>
      <p class="standfirst">{story.standfirst}</p>
      <p class="byline">
        <span class="avatar" aria-hidden="true">{story.author.initials}</span>
        <a href={localePath(locale, `/autor/${story.author.slug}`)}>{story.author.name}</a>
        <span aria-hidden="true">·</span>
        <time datetime={story.publishedAt}>{formatDate(locale, story.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{t(locale, 'article.reading', { minutes: story.readingMinutes })}</span>
      </p>
    </header>

    {/* El cuerpo ya viene de la base de datos, saneado al guardarse. Mientras
        la redacción no lo escriba, la página dice qué le falta en vez de
        fingir un texto —y menos aún un análisis de mercado— que nadie firmó. */}
    <div class="body measure">
      {story.body
        ? <Fragment set:html={story.body} />
        : <p class="pending">{t(locale, 'article.body-pending')}</p>}
    </div>

    {related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <h2 class="section-title" id="related-title">{t(locale, 'article.related')}</h2>
        <StoryGrid locale={locale} stories={related} />
      </section>
    )}
  </article>
  {/* `is:inline` explícito: no es código que Astro deba procesar, son datos
      que viajan tal cual al HTML para que los lea un buscador. */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .crumbs { display: flex; gap: var(--space-2); padding-block: var(--space-4); color: var(--muted); font-size: 0.875rem; }
  .crumbs a { color: var(--muted); }
  .head { display: flex; flex-direction: column; gap: var(--space-3); }
  h1 { font-size: clamp(1.875rem, 1.2rem + 3vw, 3rem); }
  .standfirst { margin: 0; font-size: 1.125rem; color: var(--muted); }
  .avatar {
    display: inline-grid;
    place-items: center;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-contrast);
    font-size: 0.75rem; font-weight: 700;
  }
  /* La prosa se lee a `--measure`, no al ancho del portal: 1200px de línea es
   * ilegible por muchos tokens que se usen. */
  .body { margin-block: var(--space-5); }
  /* La prosa del artículo: interlineado de lectura larga y ritmo entre
   * párrafos. `:global()` porque el HTML llega de la base de datos y no lleva
   * el atributo de ámbito que Astro pone a lo que escribe la plantilla. */
  .body :global(p) { margin-block: 0 var(--space-4); }
  .body :global(h2) { font-size: 1.5rem; margin-block: var(--space-5) var(--space-3); }
  .body :global(h3) { font-size: 1.25rem; margin-block: var(--space-4) var(--space-2); }
  .body :global(ul), .body :global(ol) { margin-block: 0 var(--space-4); padding-inline-start: var(--space-5); }
  .body :global(li) { margin-block-end: var(--space-2); }
  .body :global(blockquote) {
    margin: var(--space-4) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--primary);
    color: var(--muted);
  }
  .body :global(a) { color: var(--primary); }
  .pending { color: var(--muted); }
</style>
