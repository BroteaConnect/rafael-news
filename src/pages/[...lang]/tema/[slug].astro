---
import Layout from '../../../layouts/Layout.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import { getStoriesByTopic, getTopic } from '../../../lib/content/seed';
import { t } from '../../../lib/i18n';
import { resolveLocale } from '../../../lib/route';

const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

const topic = await getTopic(String(Astro.params.slug ?? ''), locale);
if (!topic) return Astro.rewrite('/404');

const stories = await getStoriesByTopic(topic.id, locale);
---

<Layout locale={locale} title={topic.name} description={t(locale, 'topic.description', { topic: topic.name })}>
  <section class="section container" aria-labelledby="topic-title">
    <h1 class="page-title" id="topic-title">{topic.name}</h1>
    <p class="lede">{t(locale, 'topics.count', { count: topic.count })}</p>
    <StoryGrid locale={locale} stories={stories} />
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem); }
  .lede { color: var(--muted); margin-block: var(--space-2) var(--space-5); }
</style>
