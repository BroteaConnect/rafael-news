---
import Layout from '../../layouts/Layout.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { getArticles } from '../../lib/content/store';
import { t } from '../../lib/i18n';
import { resolveLocale } from '../../lib/route';

const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

const stories = await getArticles(locale);
---

<Layout locale={locale} title={t(locale, 'nav.news')} description={t(locale, 'news.description')}>
  <section class="section container" aria-labelledby="news-title">
    <h1 class="page-title" id="news-title">{t(locale, 'nav.news')}</h1>
    <p class="lede">{t(locale, 'news.description')}</p>
    <StoryGrid locale={locale} stories={stories} />
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem); }
  .lede { color: var(--muted); max-width: 60ch; margin-block: var(--space-2) var(--space-5); }
</style>
