---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';
import { resolveLocale } from '../../lib/route';

const locale = resolveLocale(Astro.params.lang);
if (!locale) return Astro.rewrite('/404');

// Los identificadores de los anclajes NO se traducen: el pie enlaza a
// #privacidad desde cualquier idioma, y un ancla traducida rompería el enlace
// en cuanto alguien cambiase de idioma.
const SECTIONS = [
  { id: 'aviso', titleKey: 'legal.notice.title', bodyKey: 'legal.notice.body' },
  { id: 'privacidad', titleKey: 'legal.privacy.title', bodyKey: 'legal.privacy.body' },
  { id: 'cookies', titleKey: 'legal.cookies.title', bodyKey: 'legal.cookies.body' },
];
---

<Layout locale={locale} title={t(locale, 'legal.title')} description={t(locale, 'legal.description')}>
  <div class="container measure page">
    <h1>{t(locale, 'legal.title')}</h1>
    {SECTIONS.map((s) => (
      <section aria-labelledby={s.id}>
        <h2 id={s.id}>{t(locale, s.titleKey)}</h2>
        <p>{t(locale, s.bodyKey)}</p>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page { padding-block: var(--space-5); }
  h1 { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem); margin-block-end: var(--space-5); }
  h2 { font-size: 1.375rem; margin-block: var(--space-5) var(--space-2); scroll-margin-block-start: 110px; }
  p { margin: 0; }
</style>
